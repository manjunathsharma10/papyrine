{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papyrine",
  "version": "0.0.1",
  "identifier": "io.github.manjunathsharma10.papyrine",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Papyrine", "width": 900, "height": 700, "minWidth": 600, "minHeight": 400 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost papyrine: http://papyrine.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Lightweight PDF editor",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
