#!/usr/bin/env python3
"""Download, verify and extract the pinned native sources in third_party/native.toml.

Usage: third_party/fetch [name ...]     (default: all libraries)
Sources land in third_party/cache/ (gitignored). Idempotent.
"""
import hashlib
import shutil
import sys
import tarfile
import tomllib
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent
CACHE = ROOT / "cache"
SRC = CACHE / "src"


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def safe_extract(tar, dest):
    base = dest.resolve()
    for m in tar.getmembers():
        target = (dest / m.name).resolve()
        if not str(target).startswith(str(base)):
            raise SystemExit(f"refusing unsafe tar member: {m.name}")
        if m.issym() or m.islnk():
            link = (target.parent / m.linkname).resolve()
            if not str(link).startswith(str(base)):
                raise SystemExit(f"refusing unsafe tar link: {m.name}")
    tar.extractall(dest)


def fetch(lib):
    name, version, url, want = lib["name"], lib["version"], lib["url"], lib["sha256"]
    if not url.startswith("https://"):
        raise SystemExit(f"{name}: url must be https")
    archive = CACHE / url.rsplit("/", 1)[1]
    srcdir = SRC / f"{name}-{version}"
    stamp = srcdir / ".sha256"
    if stamp.exists() and stamp.read_text().strip() == want:
        print(f"{name} {version}: up to date")
        return
    CACHE.mkdir(parents=True, exist_ok=True)
    SRC.mkdir(parents=True, exist_ok=True)
    if not archive.exists() or sha256(archive) != want:
        print(f"{name} {version}: downloading {url}")
        tmp = archive.with_suffix(archive.suffix + ".part")
        req = urllib.request.Request(url, headers={"User-Agent": "papyrine-fetch"})
        with urllib.request.urlopen(req) as r, open(tmp, "wb") as f:
            shutil.copyfileobj(r, f)
        got = sha256(tmp)
        if got != want:
            tmp.unlink()
            raise SystemExit(f"{name}: SHA-256 mismatch\n  expected {want}\n  got      {got}")
        tmp.replace(archive)
    if srcdir.exists():
        shutil.rmtree(srcdir)
    with tarfile.open(archive) as tar:
        safe_extract(tar, SRC)
    if not srcdir.is_dir():
        raise SystemExit(f"{name}: archive did not contain {srcdir.name}/")
    stamp.write_text(want + "\n")
    print(f"{name} {version}: ok")


def main():
    with open(ROOT / "native.toml", "rb") as f:
        libs = tomllib.load(f)["library"]
    wanted = set(sys.argv[1:])
    unknown = wanted - {l["name"] for l in libs}
    if unknown:
        raise SystemExit(f"unknown libraries: {', '.join(sorted(unknown))}")
    for lib in libs:
        # Only source tarballs; other entries (prebuilt binaries) have their own fetchers.
        tarball = lib.get("url", "").endswith((".tar.gz", ".tgz"))
        if "sha256" in lib and tarball and (not wanted or lib["name"] in wanted):
            fetch(lib)


if __name__ == "__main__":
    main()
