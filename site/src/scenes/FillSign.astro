---
import Scene from '../components/Scene.astro';
import { product } from '../config';
const fields = [
  { y: 96, label: 'Full name', text: 'Alex Morgan', a: .05, b: .26 },
  { y: 158, label: 'Email', text: 'alex@example.com', a: .24, b: .45 },
];
---
<Scene id="fill" num="04" kicker="Fill and sign" title="Fill it in.|Sign it off." flip artClass="fill-art" chipLabel="Coming soon · signing arrives after form filling">
  <Fragment slot="text">
    <p>Type into form fields, tick the boxes, and sign with a drawn or typed signature. Form filling comes first; signing follows in a later release.</p>
  </Fragment>
  <figure>
    <div class="page fill-page">
      <svg viewBox="0 0 300 390" role="img" aria-label="A form page. The name and email fields fill in with text, a checkbox gets ticked, and a signature writes itself on the signature line." focusable="false">
        <rect class="pl-ink" x="32" y="26" width="132" height="14" rx="3"/>
        <rect class="pl" x="32" y="50" width="200" height="6" rx="3"/>
        {fields.map((f) => (
          <g>
            <text x="32" y={f.y - 8} class="lbl">{f.label}</text>
            <rect x="32" y={f.y} width="236" height="30" rx="4" fill="var(--field)" stroke="#b9c4d8"/>
            <text x="42" y={f.y + 20} class="typed">{f.text}</text>
            <rect class="fb o-r a k-cover lin cover" x="34" y={f.y + 2} width="232" height="26" fill="var(--field)" style={`--a:${f.a};--b:${f.b}`}/>
          </g>
        ))}
        <g>
          <rect x="32" y="218" width="20" height="20" rx="4" fill="var(--field)" stroke="#b9c4d8"/>
          <path class="draw a k-draw lin tick" pathLength="1" style="--a:.46;--b:.54" d="M37 228l5 5 9-11"/>
          <rect class="pl" x="62" y="223" width="150" height="6" rx="3"/>
          <rect class="pl" x="62" y="234" width="104" height="6" rx="3"/>
        </g>
        <text x="32" y="300" class="lbl">Signature</text>
        <path d="M32 340h236" stroke="var(--paper-ink)" stroke-width="1.5" opacity=".6"/>
        <path d="M36 322l8 8-8 8" stroke="var(--accent)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="signx"/>
        <path class="draw a k-draw sig" pathLength="1" style="--a:.58;--b:.94" d="M68 330c10-30 26-40 26-12 0 22-18 30-8 22 16-13 30-32 36-20 4 9-10 26 4 20 14-6 22-24 32-18 8 6-4 22 8 18 18-6 34-16 60-14"/>
      </svg>
    </div>
    <figcaption>Concept illustration of form filling and signing in {product.name}.</figcaption>
  </figure>
</Scene>
