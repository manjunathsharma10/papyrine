---
import { targets, product, license } from '../config';
const items = [
  ['Fast launch', `Aiming for under ${targets.coldLaunchSeconds.toFixed(0)} second from double-click to your first page.`, 'M13 2 4 14h7l-1 8 9-12h-7z'],
  ['Small install', `Aiming for ${targets.installGoalMb} MB, with a ${targets.installCeilingMb} MB ceiling for most installers.`, 'M12 3v12m0 0-4-4m4 4 4-4M5 20h14'],
  ['Fully offline', 'Everything runs on your machine. No cloud needed.', 'M3 9a14 14 0 0 1 18 0M6 13a9 9 0 0 1 12 0M9.5 17a4 4 0 0 1 5 0M4 4l16 16'],
  ['Private', 'Your files never leave your device.', 'M6 11V8a6 6 0 0 1 12 0v3M5 11h14v10H5z'],
  ['Cross-platform', `Planned for ${product.platforms}.`, 'M3 5h18v11H3zM8 20h8M12 16v4'],
  ['Free and open source, always', `Licensed ${license.spdx}. Read the code, or help write it.`, 'M8 6 3 12l5 6M16 6l5 6-5 6'],
];
---
<section class="glance" aria-labelledby="glance-title">
  <div class="wrap">
    <h2 id="glance-title" class="sr-only">At a glance</h2>
    <ul class="glance-grid">
      {items.map(([t, d, p]) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={p} /></svg>
          <h3>{t}</h3>
          <p>{d}</p>
        </li>
      ))}
    </ul>
    <p class="fineprint glance-note">Speed and size figures are targets from the project’s performance budgets, not measurements. There is no build to measure yet.</p>
  </div>
</section>
