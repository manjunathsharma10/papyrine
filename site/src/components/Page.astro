---
/* A sheet of paper with greeked text. `seed` varies the line pattern per page; `image` adds a picture block. */
interface Props { seed?: number; title?: boolean; image?: boolean; class?: string; style?: string; }
const { seed = 0, title = true, image = false, class: cls = '', style } = Astro.props;
const widths = [84, 80, 84, 58, 82, 76, 84, 46, 80, 84, 70, 38];
const rows: { y: number; w: number }[] = [];
const start = title ? 24 : 12;
for (let i = 0; i < 13; i++) {
  const y = start + i * 7.6;
  if (y > 118) break;
  if (image && y > 56 && y < 90) continue;
  rows.push({ y, w: widths[(i + seed * 3) % widths.length] });
}
---
<div class:list={['page', cls]} style={style}>
  <svg viewBox="0 0 100 130" aria-hidden="true" focusable="false">
    {title && <rect class="pl-ink" x="8" y="9" width="44" height="5.5" rx="1"/>}
    {rows.map((r) => <rect class="pl" x="8" y={r.y} width={r.w} height="2.6" rx="1.3"/>)}
    {image && <>
      <rect x="8" y="58" width="84" height="30" rx="2" fill="var(--paper-line)" opacity=".55"/>
      <circle cx="70" cy="68" r="5" fill="var(--accent)" opacity=".85"/>
      <path d="M8 88V78l20-12 18 10 16-8 30 14v6z" fill="var(--paper-ink)" opacity=".3"/>
    </>}
    <path d="M100 0v18H82z" fill="var(--paper-line)" opacity=".55"/>
  </svg>
  <slot />
</div>
