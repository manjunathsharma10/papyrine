{
  "name": "papyrine-site",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "node scripts/check-animations.mjs && node scripts/check-contrast.mjs && node scripts/check-js-size.mjs",
    "lhci": "lhci autorun",
    "screenshots": "node scripts/screenshots.mjs",
    "check:browser": "node scripts/check-layout.mjs && node scripts/check-fallback.mjs",
    "contact-sheet": "node scripts/contact-sheet.mjs",
    "og": "node --experimental-strip-types scripts/og.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
