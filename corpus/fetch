#!/usr/bin/env python3
"""Download the Papyrine test corpus into corpus/cache/files (ADR-017).

Reads every corpus/*.toml manifest (schema in corpus/README.md), downloads in
parallel, resumes partial downloads, verifies SHA-256 and prints a summary.
Python 3.8+, standard library only. Exit status 1 on any mismatch or failure.
"""
import argparse
import concurrent.futures as cf
import hashlib
import json
import os
import re
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

ROOT = os.path.dirname(os.path.abspath(__file__))
CACHE = os.path.join(ROOT, "cache", "files")
UA = "papyrine-corpus-fetch/1"
LOCK = threading.Lock()

def ssl_context():
    """Default context; python.org macOS builds ship without CA certs, so fall back to system bundles."""
    import ssl

    ctx = ssl.create_default_context()
    if ctx.get_ca_certs():
        return ctx
    for cafile in ("/etc/ssl/cert.pem", "/private/etc/ssl/cert.pem", "/opt/homebrew/etc/ca-certificates/cert.pem",
                   "/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt"):
        if os.path.exists(cafile):
            return ssl.create_default_context(cafile=cafile)
    return ctx


SSL_CTX = ssl_context()


def parse_toml(text):
    try:
        import tomllib

        return tomllib.loads(text)
    except ImportError:
        return mini_toml(text)


def mini_toml(text):
    """Fallback for Python < 3.11: only the manifest subset ([[file]], strings, ints, string arrays)."""
    files, cur = [], None
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line == "[[file]]":
            cur = {}
            files.append(cur)
            continue
        m = re.match(r"^([A-Za-z_][\w-]*)\s*=\s*(.+)$", line)
        if not m or cur is None:
            raise ValueError("unsupported TOML line: " + raw)
        key, val = m.group(1), m.group(2).strip()
        if val.startswith("["):
            cur[key] = json.loads(re.sub(r"\s+#.*$", "", val))
        elif val.startswith('"'):
            end = 1
            while val[end] != '"' or val[end - 1] == "\\":
                end += 1
            cur[key] = json.loads(val[: end + 1])
        else:
            cur[key] = int(re.split(r"\s+#", val)[0])
    return {"file": files}


def load_manifests():
    entries, seen = [], {}
    names = sorted(n for n in os.listdir(ROOT) if n.endswith(".toml"))
    for name in names:
        with open(os.path.join(ROOT, name), encoding="utf-8") as f:
            data = parse_toml(f.read())
        for e in data.get("file", []):
            for req in ("id", "url", "sha256", "license", "source", "tags"):
                if req not in e:
                    sys.exit("%s: entry %r is missing '%s'" % (name, e.get("id"), req))
            i = e["id"]
            if i.startswith("/") or ".." in i.split("/") or "\\" in i or ":" in i:
                sys.exit("%s: unsafe id %r" % (name, i))
            if i in seen:
                sys.exit("duplicate id %r in %s and %s" % (i, seen[i], name))
            if not re.fullmatch(r"[0-9a-f]{64}", e["sha256"]):
                sys.exit("%s: bad sha256 for %s" % (name, i))
            seen[i] = name
            e["_manifest"] = name
            entries.append(e)
    return entries


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


# Hosts that throttle hard get a small per-host concurrency cap.
HOST_LIMITS = {"web.archive.org": 2}
HOST_SEMS = {h: threading.Semaphore(n) for h, n in HOST_LIMITS.items()}
NO_SEM = threading.Semaphore(1 << 20)


def download(url, part, retries=6):
    host = urllib.parse.urlsplit(url).hostname or ""
    with HOST_SEMS.get(host, NO_SEM):
        if host in HOST_SEMS:
            time.sleep(0.5)
        _download(url, part, retries)


def _download(url, part, retries):
    """Download url to part, resuming with Range when part exists."""
    last = None
    for attempt in range(retries):
        have = os.path.getsize(part) if os.path.exists(part) else 0
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        if have:
            req.add_header("Range", "bytes=%d-" % have)
        try:
            with urllib.request.urlopen(req, timeout=60, context=SSL_CTX) as r:
                mode = "ab" if (have and r.status == 206) else "wb"
                with open(part, mode) as f:
                    while True:
                        b = r.read(1 << 18)
                        if not b:
                            break
                        f.write(b)
            return
        except urllib.error.HTTPError as ex:
            if ex.code == 416:  # range past end: part is complete or stale
                return
            last = ex
            if ex.code in (400, 401, 403, 404, 410):
                break
        except (urllib.error.URLError, TimeoutError, ConnectionError, OSError) as ex:
            last = ex
        time.sleep(1.5 * (attempt + 1))
    raise RuntimeError(str(last))


def process(e, verify_only):
    dest = os.path.join(CACHE, *e["id"].split("/"))
    want = e["sha256"]
    if os.path.exists(dest):
        got = sha256_file(dest)
        if got == want:
            return "cached", e, ""
        if verify_only:
            return "mismatch", e, "cached file hash %s" % got
        os.remove(dest)
    elif verify_only:
        return "missing", e, ""
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    part = dest + ".part"
    try:
        download(e["url"], part)
        got = sha256_file(part)
    except Exception as ex:  # noqa: BLE001
        return "failed", e, str(ex)
    if got != want:
        os.replace(part, dest + ".bad")
        return "mismatch", e, "expected %s got %s" % (want, got)
    os.replace(part, dest)
    return "downloaded", e, ""


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--tag", action="append", default=[], help="only files with this tag (repeatable, OR)")
    ap.add_argument("--exclude-tag", action="append", default=[], help="skip files with this tag")
    ap.add_argument("--manifest", action="append", default=[], help="only this manifest file name (e.g. js-forms.toml)")
    ap.add_argument("--id", action="append", default=[], help="only ids containing this substring")
    ap.add_argument("--max-size", type=int, default=0, help="skip entries whose 'size' exceeds this many bytes")
    ap.add_argument("--jobs", "-j", type=int, default=12)
    ap.add_argument("--verify", action="store_true", help="hash cached files only; no network")
    ap.add_argument("--list", action="store_true", help="print selected ids and exit")
    ap.add_argument("--quiet", "-q", action="store_true")
    a = ap.parse_args()

    entries = load_manifests()
    sel = []
    for e in entries:
        tags = set(e["tags"])
        if a.tag and not tags & set(a.tag):
            continue
        if tags & set(a.exclude_tag):
            continue
        if a.manifest and e["_manifest"] not in a.manifest:
            continue
        if a.id and not any(s in e["id"] for s in a.id):
            continue
        if a.max_size and e.get("size", 0) > a.max_size:
            continue
        sel.append(e)

    if a.list:
        for e in sel:
            print(e["id"])
        return 0

    t0 = time.time()
    counts = {"cached": 0, "downloaded": 0, "failed": 0, "mismatch": 0, "missing": 0}
    problems, bytes_dl, done = [], 0, 0
    with cf.ThreadPoolExecutor(max_workers=max(1, a.jobs)) as ex:
        futs = [ex.submit(process, e, a.verify) for e in sel]
        for fu in cf.as_completed(futs):
            st, e, msg = fu.result()
            with LOCK:
                done += 1
                counts[st] += 1
                if st == "downloaded":
                    bytes_dl += e.get("size", 0)
                if st in ("failed", "mismatch", "missing"):
                    problems.append((st, e["id"], msg))
                    print("%-8s %s %s" % (st.upper(), e["id"], msg), file=sys.stderr)
                if not a.quiet and sys.stderr.isatty() and done % 25 == 0:
                    print("\r%d/%d" % (done, len(sel)), end="", file=sys.stderr)
    if not a.quiet and sys.stderr.isatty():
        print("\r", end="", file=sys.stderr)
    dt = time.time() - t0
    print("selected %d | downloaded %d | already cached %d | failed %d | hash mismatch %d%s | %.1fs"
          % (len(sel), counts["downloaded"], counts["cached"], counts["failed"], counts["mismatch"],
             (" | missing %d" % counts["missing"]) if a.verify else "", dt))
    if a.verify and counts["missing"]:
        return 1
    return 1 if (counts["failed"] or counts["mismatch"]) else 0


if __name__ == "__main__":
    sys.exit(main())
